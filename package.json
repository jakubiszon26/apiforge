{
  "name": "apiforge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev:front": "react-router dev",
    "dev:api": "tsx watch api/server.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:front\"",
    "start": "tsx api/server.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "tsx --test tests/*.test.ts app/features/graph/*.test.ts app/features/runs/*.test.ts app/features/components/*.test.ts app/features/inspector/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app api shared tests *.ts *.json *.md",
    "format:check": "prettier --check app api shared tests *.ts *.json *.md"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/dropzone": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/spotlight": "^9.7.1",
    "@mantine/tiptap": "^9.7.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tabler/icons-react": "^3.49.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.12.0",
    "express": "^5.3.0",
    "icons-react": "^3.7.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.6",
    "node": "^22.23.3",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
