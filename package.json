{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev:front": "react-router dev",
    "dev:api": "node --watch api/server.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:front\"",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/dropzone": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/spotlight": "^9.7.1",
    "@mantine/tiptap": "^9.7.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tabler/icons-react": "^3.49.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "express": "^5.3.0",
    "icons-react": "^3.7.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
