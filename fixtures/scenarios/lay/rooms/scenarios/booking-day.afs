scenario "Room booking day" {
  description "A longer day of bookings: the double booking check comes late."
  begin = start
  token = sign_in@1(user: "tester")
  profile = GET "/me" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { id: "u-7", name: "Tester", team: "qa" }
  }
  team = GET "/teams/{{profile.body.team}}" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { id: "qa", size: 5 }
  }
  big_enough = assert team.body.size > 0
  buildings = GET "/buildings" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { items: [{ id: "hq", floors: 3 }] }
  }
  floors = GET "/buildings/{{buildings.body.items[0].id}}/floors" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { items: [{ number: 1 }, { number: 2 }, { number: 3 }] }
  }
  has_floors = assert nonempty floors.body.items
  rooms = GET "/rooms" {
    headers { Authorization: "Bearer {{token}}" }
    query { floor: 2 }
    sample 200 { items: [{ id: "room-a", name: "Room A", seats: 8, status: "open" }, { id: "room-b", name: "Room B", seats: 6, status: "maintenance" }] }
  }
  slot = { start: "2026-12-01T10:00:00Z", end: "2026-12-01T11:00:00Z" }
  equipment = GET "/rooms/{{rooms.body.items[0].id}}/equipment" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { items: ["screen", "camera"] }
  }
  has_screen = assert equipment.body.items contains "screen"
  policy = GET "/booking-policy" {
    headers { Authorization: "Bearer {{token}}" }
    sample 200 { maxHours: 4 }
  }
  short_enough = assert (policy.body.maxHours >= 1) == true
  holidays = GET "/calendar/holidays" {
    headers { Authorization: "Bearer {{token}}" }
    query { year: 2026 }
    sample 200 { items: ["2026-12-25", "2026-12-26"] }
  }
  working_day = assert holidays.body.items contains "2026-12-25"
  first = POST "/bookings" {
    headers { Authorization: "Bearer {{token}}" }
    body { roomId: rooms.body.items[0].id, start: slot.start, end: slot.end }
    sample 201 { id: "bk-1", roomId: "room-a", start: "2026-12-01T10:00:00Z", end: "2026-12-01T11:00:00Z" }
  }
  hold = POST "/payments/holds" {
    headers { Authorization: "Bearer {{token}}" }
    body { booking: first.body.id, amount: 40 }
    sample 201 { id: "h-1", amount: 40 }
  }
  held = assert hold.body.amount == 40
  invite = POST "/invitations" {
    headers { Authorization: "Bearer {{token}}" }
    body { booking: first.body.id, team: profile.body.team }
    sample 201 { id: "i-1", invited: 5 }
  }
  invited = assert invite.body.invited == team.body.size
  notice = POST "/notifications" {
    headers { Authorization: "Bearer {{token}}" }
    body { channel: "email", text: "Your booking is confirmed." }
    sample 202 { id: "n-1" }
  }
  sent = assert notice.status == 202
  booked = if first.status == 201 {
    second = POST "/bookings" {
      headers { Authorization: "Bearer {{token}}" }
      body { roomId: rooms.body.items[1].id, start: slot.start, end: slot.end }
      sample 409 { error: { code: "room_unavailable", message: "The room is closed for maintenance." } }
    }
    refused = assert second.status == 409
    calendar = GET "/rooms/{{rooms.body.items[0].id}}/bookings" {
      headers { Authorization: "Bearer {{token}}" }
      query { from: slot.start, to: slot.end }
      sample 200 { items: [{ id: "bk-1", start: "2026-12-01T10:00:00Z", end: "2026-12-01T11:00:00Z" }] }
    }
    one_booking = assert calendar.body.items[0].id == first.body.id
  } else {
    not_booked = assert first.status == 201
  }
  cleanup {
    released = DELETE "/payments/holds/{{hold.body.id}}" {
      headers { Authorization: "Bearer {{token}}" }
      sample 204 {}
    }
    cancelled = DELETE "/bookings/{{first.body.id}}" {
      headers { Authorization: "Bearer {{token}}" }
      sample 204 {}
    }
    gone = assert cancelled.status == 204
  }
}
