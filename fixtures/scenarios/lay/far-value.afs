scenario "Far value" {
  description "LAY-25 mock-up: the values of a cart component and of a session, read directly by far steps."
  on_error stop
  param coupon = "WELCOME10"
  param email = "guest@example.com"
  begin = start
  @after(begin)
  session = POST "/session" {
    body { email: param.email }
    sample 201 { id: "s-1", currency: "PLN" }
  }
  @after(session)
  catalogue = GET "/products" {
    query { limit: 5 }
    sample 200 { items: [{ id: 123, price: 100 }] }
  }
  product = product@1(id: catalogue.body.items[0].id)
  cart = add_to_cart@1(product: product, quantity: 2)
  @after(cart)
  quantity = PATCH "/carts/{{cart.cart.id}}/items/{{cart.cart.productId}}" {
    body { quantity: 3 }
    sample 200 { id: "c-1", quantity: 3 }
  }
  quantity_ok = assert quantity.status == 200
  @after(quantity_ok)
  apply_coupon = POST "/carts/{{cart.cart.id}}/coupon" {
    body { code: param.coupon }
    sample 200 { id: "c-1", coupon: "WELCOME10" }
  }
  coupon_ok = assert apply_coupon.status == 200
  @after(coupon_ok)
  note = PUT "/carts/{{cart.cart.id}}/items/{{cart.cart.productId}}/note" {
    body { text: "Gift wrap" }
    sample 200 { ok: true }
  }
  note_ok = assert note.status == 200
  @after(note_ok)
  stock = GET "/carts/{{cart.cart.id}}/items/{{cart.cart.productId}}/stock" {
    sample 200 { available: 12 }
  }
  in_stock = assert stock.body.available > 2
  @after(in_stock)
  shipping = PUT "/carts/{{cart.cart.id}}/shipping" {
    body { method: "courier", item: cart.cart.productId }
    sample 200 { ok: true }
  }
  shipping_ok = assert shipping.status == 200
  @after(shipping_ok)
  remove_coupon = DELETE "/carts/{{cart.cart.id}}/coupon" {
    sample 200 { id: "c-1" }
  }
  removed_ok = assert remove_coupon.status == 200
  @after(removed_ok)
  view = GET "/carts/{{cart.cart.id}}" {
    sample 200 { id: "c-1", items: [{ id: 123, quantity: 3 }] }
  }
  same_item = assert view.body.items[0].id == cart.cart.productId
  @after(same_item)
  checkout = POST "/checkout" {
    body { cartId: cart.cart.id, itemId: cart.cart.productId, currency: session.body.currency, email: param.email, payment: "card" }
    sample 201 { id: "o-1", orderNumber: "N-0001", state: "new" }
  }
  checkout_ok = condition all {
    checkout.status == 201,
    checkout.body.state == "new",
    nonempty checkout.body.orderNumber,
  }
  @after(checkout_ok)
  lookup = GET "/orders/by-number/{{checkout.body.orderNumber}}" {
    query { email: param.email, cart: cart.cart.id, currency: session.body.currency }
    sample 200 { id: "o-1", orderNumber: "N-0001", state: "paid" }
  }
  lookup_ok = condition all {
    lookup.status == 200,
    lookup.body.orderNumber == checkout.body.orderNumber,
  }
}
