#!/bin/sh
# The AppImage's entry point (REL-01): the window with the few libraries the
# AppImage carries in usr/lib ahead of the host's. glibc, X11, Wayland, GL and
# Vulkan stay the host's.
here="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$here/usr/bin/apiforge-desktop" "$@"
